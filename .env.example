# ============================================================
# Dashboard env
# Copy these into apps/dashboard/.env.local with real values
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
# Server-only secret. Used for admin operations (e.g. account deletion).
# Never expose to the browser — files that read this must `import "server-only"`.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Extension env
# Copy these into apps/extension/.env.local with real values
# ============================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DASHBOARD_URL=

# ============================================================
# Supabase Edge Function secrets
# Set with: supabase secrets set KEY=value
# DO NOT put these in any .env file
# ============================================================
# VOYAGE_API_KEY
# ANTHROPIC_API_KEY      # Claude Haiku for resume-fit scoring (PR-C3)
# EDGE_FUNCTION_SECRET   # x-internal-secret for pg_net-triggered functions
#                        # (generate-embedding, generate-resume-embedding)
