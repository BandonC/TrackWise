# ============================================================
# Dashboard env
# Copy these into apps/dashboard/.env.local with real values
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
# Server-only secret. Used for admin operations (e.g. account deletion).
# Never expose to the browser — files that read this must `import "server-only"`.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for invoking internal-only Edge Functions
# (generate-embedding, cluster-embeddings). Must match the value set in
# Supabase secrets. Server-only — `import "server-only"` in callers.
EDGE_FUNCTION_SECRET=

# ============================================================
# Extension env
# Copy these into apps/extension/.env.local with real values
# ============================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DASHBOARD_URL=

# ============================================================
# Supabase Edge Function secrets
# Set with: supabase secrets set KEY=value
# DO NOT put these in any .env file
# ============================================================
# VOYAGE_API_KEY
