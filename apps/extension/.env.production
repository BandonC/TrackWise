# Production env for the extension build (the CWS-shipped zip).
# Vite loads this automatically when building in production mode;
# values here override .env.local because .env.[mode] has higher
# precedence than .env.local.
#
# Only the dashboard URL changes between dev and prod -- Supabase
# URL/anon key are the same project across environments, so they
# stay in .env.local.
VITE_DASHBOARD_URL=https://trackwise-lac-nu.vercel.app
