{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@trackwise/types": ["../../packages/types/src/index.ts"],
      "@trackwise/types/*": ["../../packages/types/src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "manifest.config.ts"]
}
